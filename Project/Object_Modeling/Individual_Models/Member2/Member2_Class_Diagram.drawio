<mxfile host="app.diagrams.net"><diagram name="Member 2 Class Diagram" id="m2cd"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c_Finder" value="&lt;b&gt;Finder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;(Member 1)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="130" y="40" width="320" height="60" as="geometry"/></mxCell><mxCell id="c_FoundItemReport" value="&amp;lt;&amp;lt;entity&amp;gt;&amp;gt;&lt;br&gt;FoundItemReport" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=none;strokeColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="500" height="286" as="geometry"/></mxCell><mxCell id="a_FoundItemReport" value="- reportId: String&lt;br&gt;- category: String&lt;br&gt;- description: String&lt;br&gt;- color: String&lt;br&gt;- foundLocation: String&lt;br&gt;- dateTimeFound: Date&lt;br&gt;- submittedOn: Date&lt;br&gt;- status: ReportStatus" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c_FoundItemReport"><mxGeometry y="44" width="500" height="128" as="geometry"/></mxCell><mxCell id="s_FoundItemReport" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="c_FoundItemReport"><mxGeometry y="172"