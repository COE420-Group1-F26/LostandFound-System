ht="23" as="geometry"/></mxCell><mxCell id="s_MatchingService" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="c_MatchingService"><mxGeometry y="67" width="540" height="1" as="geometry"/></mxCell><mxCell id="m_MatchingService" value="+ findMatchesForFound(found: FoundItemReport): List&amp;lt;MatchSuggestion&amp;gt;&lt;br&gt;+ findMatchesForLost(lost: LostItemReport): List&amp;lt;MatchSuggestion&amp;gt;&lt;br&gt;- calculateScore(lost: LostItemReport, found: FoundItemReport): double&lt;br&gt;- rankMatches(matches: List&amp;lt;MatchSuggestion&amp;gt;): List&amp;lt;MatchSuggestion&amp;gt;&lt;br&gt;+ notifyOwner(match: MatchSuggestion): Notification" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c_MatchingService"><mxGeometry y="68" width="540" height="83" as="geometry"/></mxCell><mxCell id="c_MatchSuggestion" value="&amp;lt;&amp;lt;entity&amp;gt;&amp;gt;&lt;br&gt;MatchSuggestion" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=none;strokeColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="640" y="330" width="540" height="181" as="geometry"/></mxCell><mxCell id="a_MatchSuggestion" value="- matchId: String&lt;br&gt;- score: double&lt;br&gt;- rank: int&lt;br&gt;- createdOn: Date&lt;br&gt;- viewedByOwner: boolean" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c_MatchSuggestion"><mxGeometry y="44" width="540" height="83" as="geometry"/></mxCell><mxCell id="s_MatchSuggestion" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="c_MatchSuggestion"><mxGeometry y="127" width="540" height="1" as="geometry"/></mxCell><mxCell id="m_MatchSuggestion" value="+ getScore(): double&lt;br&gt;+ getDetails(): String&lt;br&gt;+ markViewed(): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c_MatchSuggestion"><mxGeometry y="128" width="540" height="53" as="geometry"/></mxCell><mxCell id="c_Notification" value="&amp;lt;&amp;lt;entity&amp;gt;&amp;gt;&lt;br&gt;Notification" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=none;strokeColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="640" y="660" width="540" height="196" as="geometry"/></mxCell><mxCell id="a_Notification" value="- notificationId: String&lt;br&gt;- recipientEmail: String&lt;br&gt;- message: String&lt;br&gt;- detailsLink: String&lt;br&gt;- sentOn: Date&lt;br&gt;- delivered: boolean" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c_Notification"><mxGeometry y="44" width="540" height="98" as="geometry"/></mxCell><mxCell id="s_Notification" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="c_Notification"><mxGeometry y="142" width="540" height="1" as="geometry"/></mxCell><mxCell id="m_Notification" value="+ send(): boolean&lt;br&gt;+ recordDeliveryStatus(delivered: boolean): void&lt;br&gt;- buildMessage(found: FoundItemReport): String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c_Notification"><mxGeometry y="143" width="540" height="53" as="geometry"/></mxCell><mxCell id="c_LostItemReport" value="&lt;b&gt;LostItemReport&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;(Member 1)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1300" y="390" width="320" height="60" as="geometry"/></mxCell><mxCell id="c_ItemOwner" value="&lt;b&gt;ItemOwner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;(Member 1)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1300" y="728" width="320" height="60" as="geometry"/></mxCell><mxCell id="n_match" value="Score is based on category, description keywords and location/date proximity (FR-09, UC-09). Suggestions below minimumScore are dropped; the rest are ranked by score and stored in D4 Match Suggestions." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;spacingRight=8;fillColor=none;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="40" width="360" height="92" as="geometry"/></mxCell><mxCell id="n_found" value="Found reports are stored in D3 Found Item Reports (UC-06, FR-06). A report holds up to 3 photos (FR-07, UC-07). edit() and withdraw() return false once the status is CLAIMED or RETURNED (FR-08, UC-08). The Finder sees the status with getStatus() (FR-10, UC-10)." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;spacingRight=8;fillColor=none;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="500" height="82" as="geometry"/></mxCell><mxCell id="n_notif" value="The owner of the lost report gets an email with the found item&amp;#x27;s category, location found, date found and a link to its details (FR-04). Opening it is UC-04." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;spacingRight=8;fillColor=none;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="860" width="360" height="82" as="geometry"/></mxCell><mxCell id="n_legend" value="No inheritance in this component: ReportStatus is an enumeration (a fixed list of values), not a parent class, and FoundItemReport / LostItemReport are kept as separate classes until the team decides on a shared parent in Exercise 3. Dashed boxes belong to Member 1." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;spacingRight=8;fillColor=none;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="900" width="540" height="82" as="geometry"/></mxCell><mxCell id="e_submits" value="submits" style="endArrow=none;html=1;rounded=0;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c_Finder" target="c_FoundItemReport"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_has" value="has" style="endArrow=none;startArrow=diamondThin;startFill=1;startSize=16;html=1;rounded=0;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.155;exitY=1;entryX=0.34;entryY=0;" edge="1" parent="1" source="c_FoundItemReport" target="c_ItemPhoto"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_uses" value="&amp;lt;&amp;lt;uses&amp;gt;&amp;gt;" style="endArrow=open;dashed=1;endSize=10;html=1;rounded=0;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.85;exitY=1;entryX=0.66;entryY=0;" edge="1" parent="1" source="c_FoundItemReport" target="c_ReportStatus"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_pointsto" value="points to" style="endArrow=none;html=1;rounded=0;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.806;" edge="1" parent="1" source="c_MatchSuggestion" target="c_FoundItemReport"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_isfor" value="is for" style="endArrow=none;html=1;rounded=0;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c_MatchSuggestion" target="c_LostItemReport"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_creates" value="creates" style="endArrow=none;html=1;rounded=0;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c_MatchingService" target="c_MatchSuggestion"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_announces" value="announces" style="endArrow=none;html=1;rounded=0;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c_Notification" target="c_MatchSuggestion"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_sentto" value="is sent to" style="endArrow=none;html=1;rounded=0;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c_Notification" target="c_ItemOwner"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mult_37" value="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=none;