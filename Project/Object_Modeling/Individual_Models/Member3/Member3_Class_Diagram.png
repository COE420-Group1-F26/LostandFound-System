vertex="1" parent="1"><mxGeometry x="1426.0" y="727.0" width="36" height="18" as="geometry"/></mxCell><mxCell id="mult_12" value="0..*" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1426.0" y="624.0" width="36" height="18" as="geometry"/></mxCell><mxCell id="e_records" value="records" style="endArrow=none;html=1;rounded=0;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.0;exitY=0.5;entryX=1.0;entryY=0.7514;" edge="1" parent="1" source="c_Officer" target="c_VerificationRecord"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mult_13" value="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1248.0" y="767.0" width="36" height="18" as="geometry"/></mxCell><mxCell id="mult_14" value="0..*" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1006.0" y="767.0" width="36" height="18" as="geometry"/></mxCell><mxCell id="n_claim" value="Claims are saved in D5. To claim an item you give your AUS ID and at least one private detail, and the claim starts as PENDING_VERIFICATION (FR-05, UC-05). Only a security officer can approve or reject it (FR-12, FR-13)." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;spacingRight=8;fillColor=none;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="20" width="440" height="100" as="geometry"/></mxCell><mxCell id="n_release" value="Rule (FR-14): the item can only be released if the claim is APPROVED. Otherwise markReadyForRelease() doesn&#x27;t make a ReleaseRecord." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;spacingRight=8;fillColor=none;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="610" width="380" height="80" as="geometry"/></mxCell><mxCell id="n_history" value="Claim history (UC-15, FR-15): every approve or reject is saved as a VerificationRecord with the decision, the officer and the date and time." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;spacingRight=8;fillColor=none;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="880" width="440" height="82" as="geometry"/></mxCell><mxCell id="n_dispute" value="A dispute is when 2 or more people claim the same item (UC-14, FR-16). The officer approves the one that proves it&#x27;s theirs and rejects the rest." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;spacingRight=8;fillColor=none;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1620" y="740" width="330" height="120" as="geometry"/></mxCell><mxCell id="n_legend" value="No inheritance here: ClaimStatus is just a list of values, not a parent class, and none of my classes is a type of another. Dashed boxes are Member 1&#x27;s and Member 2&#x27;s classes." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;spacingRight=8;fillColor=none;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="880" width="400" height="82" as="geometry"/></mxCell><mxCell id="nl_claim" style="endArrow=none;dashed=1;html=1;exitX=0.3182;exitY=1.0;entryX=0.8148;entryY=0.0;" edge="1" parent="1" source="n_claim" target="c_Claim"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nl_release" style="endArrow=none;dashed=1;html=1;exitX=0.3158;exitY=0.0;entryX=0.3636;entryY=1.0;" edge="1" parent="1" source="n_release" target="c_ReleaseRecord"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nl_history" style="endArrow=none;dashed=1;html=1;exitX=0.5;exitY=0.0;entryX=0.5;entryY=1.0;" edge="1" parent="1" source="n_history" target="c_VerificationRecord"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nl_dispute" style="endArrow=none;dashed=1;html=1;exitX=0.1818;exitY=0.0;entryX=0.8478;entryY=1.0;" edge="1" parent="1" source="n_dispute" target="c_DisputeCase"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>