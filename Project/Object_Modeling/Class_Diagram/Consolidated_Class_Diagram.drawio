"/></mxCell><mxCell id="s_VR" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="c_VR"><mxGeometry y="112" width="430" height="1" as="geometry"/></mxCell><mxCell id="m_VR" value="+ getDecision(): ClaimStatus&lt;br&gt;+ getSummary(): String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c_VR"><mxGeometry y="113" width="430" height="38" as="geometry"/></mxCell><mxCell id="c_Release" value="&amp;lt;&amp;lt;entity&amp;gt;&amp;gt;&lt;br&gt;ReleaseRecord" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1810" y="960" width="300" height="151" as="geometry"/></mxCell><mxCell id="a_Release" value="- releaseId: String&lt;br&gt;- readyOn: Date&lt;br&gt;- releasedOn: Date&lt;br&gt;- receivedByAusId: String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c_Release"><mxGeometry y="44" width="300" height="68" as="geometry"/></mxCell><mxCell id="s_Release" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="c_Release"><mxGeometry y="112" width="300" height="1" as="geometry"/></mxCell><mxCell id="m_Release" value="+ confirmHandover(ausId: String): boolean&lt;br&gt;+ isReleased(): boolean" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c_Release"><mxGeometry y="113" width="300" height="38" as="geometry"/></mxCell><mxCell id="c_ClaimStatus" value="&amp;lt;&amp;lt;enumeration&amp;gt;&amp;gt;&lt;br&gt;ClaimStatus" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="2140" y="1180" width="230" height="97" as="geometry"/></mxCell><mxCell id="a_ClaimStatus" value="PENDING_VERIFICATION&lt;br&gt;APPROVED&lt;br&gt;REJECTED" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c_ClaimStatus"><mxGeometry y="44" width="230" height="53" as="geometry"/></mxCell><mxCell id="c_n_users" value="Item Owner and Finder are roles played by the same AUS account (CampusMember); the people themselves are actors outside the system. Accounts are stored in D1 User Accounts (UC-01, FR-01)." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;spacingRight=8;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="80" width="440" height="72" as="geometry"/></mxCell><mxCell id="c_n_reports" value="Lost reports are stored in D2 and found reports in D3. A lost report has at most 1 photo (FR-02); a found report has up to 3 (FR-07). getPublicDetails() hides privateDetails from other users (FR-02). edit() and withdraw() refuse once the item is CLAIMED (FR-08)." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;spacingRight=8;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="1200" width="600" height="76" as="geometry"/></mxCell><mxCell id="c_n_match" value="Score from category, description keywords and location/date proximity; suggestions are ranked and stored in D4 (FR-09, UC-09). recipientEmail is copied from LostItemReport.contactEmail (D2); the email goes to the owner of the lost report (FR-04, UC-04)." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;spacingRight=8;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="95" y="1370" width="520" height="80" as="geometry"/></mxCell><mxCell id="c_n_release" value="Claims are stored in D5. Claim.approve() sets the found item to CLAIMED; ReleaseRecord.confirmHandover() sets it to RETURNED (DFD Item Status Update, FR-10). Release only after APPROVED (FR-14)." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;spacingRight=8;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1810" y="1320" width="400" height="92" as="geometry"/></mxCell><mxCell id="c_n_vr" value="VerificationRecord.decision is only APPROVED or REJECTED. Together the records are the claim history, with the officer and the date and time (FR-15, UC-15)." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;spacingRight=8;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2430" y="1320" width="430" height="72" as="geometry"/></mxCell><mxCell id="c_n_dispute" value="All claims in a dispute are for the same found item. resolve() approves the winning claim and rejects every other one, so each gets a VerificationRecord (FR-16, UC-14)." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;spacingRight=8;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2440" y="812" width="420" height="70" as="geometry"/></mxCell><mxCell id="e_g1" value="" style="endArrow=block;endFill=0;endSize=16;html=1;rounded=0;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.0;entryX=0.5;entryY=1.0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_CampusMember" target="c_User"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="262"/><mxPoint x="1750" y="262"/></Array></mxGeometry></mxCell><mxCell id="e_g2" value="" style="endArrow=block;endFill=0;endSize=16;html=1;rounded=0;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.0;entryX=0.5;entryY=1.0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_CSO" target="c_User"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2310" y="262"/><mxPoint x="1750" y="262"/></Array></mxGeometry></mxCell><mxCell id="e_g3" value="" style="endArrow=block;endFill=0;endSize=16;html=1;rounded=0;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.0;entryX=0.5;entryY=1.0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_Lost" target="c_ItemReport"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="840"/><mxPoint x="1120" y="840"/></Array></mxGeometry></mxCell><mxCell id="e_g4" value="" style="endArrow=block;endFill=0;endSize=16;html=1;rounded=0;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.0;entryX=0.5;entryY=1.0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_Found" target="c_ItemReport"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1470" y="840"/><mxPoint x="1120" y="840"/></Array></mxGeometry></mxCell><mxCell id="e_dSearch" value="&amp;lt;&amp;lt;uses&amp;gt;&amp;gt;" style="endArrow=open;dashed=1;endSize=10;html=1;rounded=0;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.4959;entryX=0.0;entryY=0.3311;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_CampusMember" target="c_ItemSearch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_look" value="looks through" style="endArrow=none;html=1;rounded=0;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.7167;exitY=1.0;entryX=0.9712;entryY=0.0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_ItemSearch" target="c_Found"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l_look_ms" value="0..*" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1677.0" y="464.0" width="48" height="18" as="geometry"/></mxCell><mxCell id="l_look_mt" value="0..*" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1705.0" y="849.0" width="48" height="18" as="geometry"/></mxCell><mxCell id="e_reports" value="reports" style="endArrow=none;html=1;rounded=0;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.875;exitY=1.0;entryX=0.0441;entryY=0.0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_CampusMember" target="c_Lost"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l_reports_ms" value="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="707.0" y="424.0" width="48" height="18" as="geometry"/></mxCell><mxCell id="l_reports_mt" value="0..*" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="735.0" y="849.0" width="48" height="18" as="geometry"/></mxCell><mxCell id="l_reports_rs" value="owner" style="text;html=1;align=center;vertical